# Copy to .env (git-ignored) and fill in. Never commit real credentials.
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=us
TCONNECT_EMAIL=
TCONNECT_PASSWORD=
TCONNECT_REGION=US
# Pump-local timezone; tconnectsync defaults to America/New_York otherwise.
TIMEZONE_NAME=America/Los_Angeles
# Nightscout instance (read by tconnectsync).
NS_URL=
NS_SECRET=
