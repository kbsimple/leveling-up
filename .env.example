# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# Dexcom Share (the sharer's account, not a follower).
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=us

# Tandem Source.
TCONNECT_EMAIL=
TCONNECT_PASSWORD=
TCONNECT_REGION=US

# Nightscout.
NS_URL=
NS_SECRET=

# Pump-local timezone (tconnectsync defaults to America/New_York otherwise).
TIMEZONE_NAME=America/Los_Angeles

# Control-IQ always uses a 5-hour insulin duration; written to the NS profile.
INSULIN_DURATION_HOURS=5

# Polling schedule, in minutes.
DEXCOM_INTERVAL_MINUTES=5
TANDEM_INTERVAL_MINUTES=15
# Boost mode: poll Tandem every BOOST_INTERVAL for BOOST_DURATION.
BOOST_INTERVAL_MINUTES=5
BOOST_DURATION_MINUTES=30

# Control API. Required when the API listens beyond loopback (always the case
# in Docker). Generate with: openssl rand -hex 24
CONTROL_TOKEN=
